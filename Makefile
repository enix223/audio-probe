# Convenience targets. The Linux host build is CMake/Ninja; LN882H delegates to
# the SDK project generated by build/ln882h/setup.sh.

.PHONY: linux linux-test linux-clean server server-test web golden provenance io-check \
        ln882h-recorder-setup ln882h-recorder-build

linux:
	cmake -S . -B out/nix -G Ninja -DCMAKE_BUILD_TYPE=Release
	cmake --build out/nix --target recorder -j

linux-test:
	cmake -S . -B out/nix -G Ninja -DCMAKE_BUILD_TYPE=Debug
	cmake --build out/nix --target recorder-tests -j
	./out/linux/recorder-tests

linux-clean:
	rm -rf out/nix out/linux

server:
	cd server && go build -o ../out/linux/recorderd ./cmd/recorderd
	cd server && go build -o ../out/linux/lab-broker ./cmd/lab-broker
	cd server && go build -o ../out/linux/recorderctl ./cmd/recorderctl

server-test:
	cd server && go test ./...

web:
	./scripts/build_web.sh

golden:
	python3 protocol/golden/gen_vectors.py

provenance:
	@echo "Dependencies are git submodules:"
	@git submodule status --recursive

io-check:
	@test -f lib/embedded-iot-client/CMakeLists.txt || \
		(echo "missing lib/embedded-iot-client; run git submodule update --init" && exit 1)

ln882h-recorder-setup: io-check
	./build/ln882h/setup.sh

ln882h-recorder-build: io-check
	./scripts/build_ln882h.sh
