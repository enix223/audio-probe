#pragma once

#define CONFIG_IOT_PLATFORM_LN882H

// ---------------------
// Basic configuration
// ---------------------

// Health check interval (ms); 0 disables the periodic health check
#ifndef CONFIG_IOT_HEALTH_CHECK_INTERVAL_MS
#define CONFIG_IOT_HEALTH_CHECK_INTERVAL_MS 10000
#endif

// HMAC backend
#define CONFIG_IOT_HMAC_USE_MBEDTLS

// Log level: 0=ERROR, 1=WARN, 2=INFO, 3=DEBUG
#ifndef CONFIG_IOT_LOG_LEVEL
#define CONFIG_IOT_LOG_LEVEL 3
#endif

// Enable thread list + stack usage logging in HealthCheck (requires FreeRTOS configUSE_TRACE_FACILITY=1)
#ifndef CONFIG_IOT_THREAD_TRACE
#define CONFIG_IOT_THREAD_TRACE 0
#endif

// Enable BLE provisioning (1 = enabled, 0 = disabled)
#ifndef CONFIG_IOT_BLE_PROVISION_ENABLE
#define CONFIG_IOT_BLE_PROVISION_ENABLE 0
#endif

#if CONFIG_IOT_BLE_PROVISION_ENABLE
// BLE advertising name
#ifndef CONFIG_IOT_ADVERTISING_NAME
#define CONFIG_IOT_ADVERTISING_NAME "IoTClient"
#endif
#endif  // CONFIG_IOT_BLE_PROVISION_ENABLE

// Network credentials — leave empty for BLE provisioning (non-empty values override provisioned credentials)
#ifndef CONFIG_IOT_NETWORK_SSID
#define CONFIG_IOT_NETWORK_SSID "@RECORDER_WIFI_SSID@"
#endif

#ifndef CONFIG_IOT_NETWORK_PASSWORD
// WiFi password
#define CONFIG_IOT_NETWORK_PASSWORD "@RECORDER_WIFI_PASSWORD@"
#endif

// NTP server
#ifndef CONFIG_IOT_NTP_SERVER
#define CONFIG_IOT_NTP_SERVER "ntp.aliyun.com"
#endif

// IoT product ID (integer, used for BLE provisioning key derivation)
#ifndef CONFIG_IOT_PRODUCT_ID_INT
#define CONFIG_IOT_PRODUCT_ID_INT 0
#endif

// IoT device ID (used across all platforms: OneNET device name, Azure device ID, AWS thing name).
// It is also the MAC advertised during BLE provisioning ("2250C25E1088" or "22:50:C2:5E:10:88"),
// which the app sends to the backend to look the device up — so it must match the unit's real MAC.
// Leave EMPTY when the MAC is set at runtime (e.g. written over UART by the MCU): a non-empty
// compile-time value wins over the stored one and would advertise the wrong device.
#ifndef CONFIG_IOT_DEVICE_ID
#define CONFIG_IOT_DEVICE_ID "@RECORDER_MQTT_DEVICE_ID@"
#endif

#ifndef CONFIG_IOT_DEVICE_SECRET
// IoT device secret
#define CONFIG_IOT_DEVICE_SECRET "@RECORDER_MQTT_DEVICE_SECRET@"
#endif

// Thing model JSON string
#ifndef CONFIG_IOT_THING_MODEL_STRING
#define CONFIG_IOT_THING_MODEL_STRING R"RECORDER_TM(@RECORDER_THING_MODEL@)RECORDER_TM"
#endif

// Thing model backend API URL - fetched before every MQTT connect (empty = disabled)
#ifndef CONFIG_IOT_THING_MODEL_API_URL
#define CONFIG_IOT_THING_MODEL_API_URL ""
#endif

// Timezone offset from UTC (e.g. 8 for CST, -5 for EST)
#ifndef CONFIG_IOT_TIMEZONE
#define CONFIG_IOT_TIMEZONE 8
#endif

// Business serial port device path (unused on embedded platforms)
#ifndef CONFIG_IOT_BIZ_SERIAL_DEVICE
#define CONFIG_IOT_BIZ_SERIAL_DEVICE ""
#endif

// @select CONFIG_IOT_PLATFORM
#if !defined(CONFIG_IOT_PLATFORM_ONENET) && !defined(CONFIG_IOT_PLATFORM_AZURE) && !defined(CONFIG_IOT_PLATFORM_AWS) && !defined(CONFIG_IOT_PLATFORM_ALIOT) && !defined(CONFIG_IOT_PLATFORM_SELF_HOSTED_MQTT)
#define CONFIG_IOT_PLATFORM_ONENET
#endif

// ---------------------
// UART configuration
// ---------------------

// --- UART configuration ---
// The user (business) serial and the system log serial each own one UART; the
// two port numbers must differ (the build fails otherwise). Pin encoding for
// both: port * 16 + pin (PA0=0..PA15=15, PB0=16..PB15=31). Conventional pins
// per UART: UART0 TX=PB9 (25) RX=PB8 (24), UART1 TX=PA2 (2) RX=PA3 (3),
// UART2 TX=PA4 (4) RX=PA1 (1) — match them to your board's wiring.
// Log baud is CFG_UART_BAUDRATE_LOG (proj_config.h).

// User serial (for communicating with external MCU)
#ifndef CONFIG_IOT_USER_SERIAL_BAUD
// User serial (UART) baud rate
#define CONFIG_IOT_USER_SERIAL_BAUD 9600
#endif

// Serial port ID for the user (business) serial (0=UART0, 1=UART1, 2=UART2)
#ifndef CONFIG_IOT_USER_SERIAL_PORT
// User serial port number (0=UART0, 1=UART1, 2=UART2)
#define CONFIG_IOT_USER_SERIAL_PORT 2
#endif

// User serial TX pin encoding: port * 16 + pin (PA0=0..PA15=15, PB0=16..PB15=31)
#ifndef CONFIG_IOT_USER_SERIAL_TX_PIN
// User serial TX pin (PA4 = the UART2 default)
#define CONFIG_IOT_USER_SERIAL_TX_PIN 4
#endif

// User serial RX pin encoding: port * 16 + pin (PA0=0..PA15=15, PB0=16..PB15=31)
#ifndef CONFIG_IOT_USER_SERIAL_RX_PIN
// User serial RX pin (PA1 = the UART2 default)
#define CONFIG_IOT_USER_SERIAL_RX_PIN 1
#endif

// Serial port ID for the system log (0=UART0, 1=UART1, 2=UART2)
#ifndef CONFIG_IOT_LOG_SERIAL_PORT
// System log port number (0=UART0, 1=UART1, 2=UART2)
#define CONFIG_IOT_LOG_SERIAL_PORT 0
#endif

// Log serial TX pin encoding: port * 16 + pin (PA0=0..PA15=15, PB0=16..PB15=31)
#ifndef CONFIG_IOT_LOG_SERIAL_TX_PIN
// Log serial TX pin (PB9 = the UART0 default)
#define CONFIG_IOT_LOG_SERIAL_TX_PIN 25
#endif

// Log serial RX pin encoding: port * 16 + pin (PA0=0..PA15=15, PB0=16..PB15=31)
#ifndef CONFIG_IOT_LOG_SERIAL_RX_PIN
// Log serial RX pin (PB8 = the UART0 default)
#define CONFIG_IOT_LOG_SERIAL_RX_PIN 24
#endif

// Enable UART DMA on one port; uses DMA CH5 (RX) and CH6 (TX), so only one
// UART can use it at a time.
#ifndef CONFIG_IOT_UART_DMA_ENABLE
// Enable UART DMA (0 = disabled, 1 = UART1, 2 = UART2; UART0 has no DMA path)
#define CONFIG_IOT_UART_DMA_ENABLE 1
#endif

// DMA RX buffer size (bytes). Data is DMA'd here, then copied to the caller.
// Must be large enough to hold bursts between consumer reads.
#if CONFIG_IOT_UART_DMA_ENABLE
#ifndef CONFIG_IOT_UART_DMA_RX_BUF_SIZE
#define CONFIG_IOT_UART_DMA_RX_BUF_SIZE 2048
#endif
#endif

