#define CONFIG_RECORDER_WS_TOKEN "@RECORDER_WS_TOKEN@"
#define CONFIG_RECORDER_WS_CA_PEM "@RECORDER_WS_CA_PEM@"
#define CONFIG_RECORDER_WS_INSECURE @RECORDER_WS_INSECURE@
#define CONFIG_RECORDER_TX_QUEUE_RECORDS 32
#define CONFIG_RECORDER_TX_QUEUE_BYTES 16384

