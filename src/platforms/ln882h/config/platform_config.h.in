#define RECORDER_MCU_LN882H 1
#define CONFIG_RECORDER_GX_UART_PORT 1
#define CONFIG_RECORDER_GX_BAUD 1000000
// Flow-control pin encoding: port*16+pin. PA5 = 5. Verify against the board.
#define CONFIG_RECORDER_GX_FC_PIN 5
